# 监听地址，格式为 ip:port，例如 :8080
LISTEN=127.0.0.1:8080

# 日志文件保存路径
LOG=/var/log/bepusdt/

# SQLite 数据库文件路径（如果使用 MySQL，此项可忽略）
# SQLITE=/var/lib/bepusdt/sqlite.db

# 推荐使用 config.yaml / config.enc 管理数据库连接，详见 config.yaml.example
# 加密工具：go build -o config-cipher ./tools/config-cipher
# config-cipher encrypt -in config.yaml -out config.enc

# MySQL 数据库（也可写入 config.yaml 的 mysql_dsn）
# MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/bepusdt?charset=utf8mb4&parseTime=True&loc=Local&timeout=3s&readTimeout=10s&writeTimeout=10s

# PostgreSQL 数据库（也可写入 config.yaml 的 postgresql_dsn）
# POSTGRESQL_DSN=postgres://user:password@localhost:5432/bepusdt?sslmode=disable&connect_timeout=3